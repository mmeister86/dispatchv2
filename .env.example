# Public development deployment configuration; never put server secrets in VITE_*.
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_SITE_URL=http://localhost:5173
# Explicit opt-in for isolated legacy UI regression/demo only:
# VITE_DEMO_MODE=true
# Configure BETTER_AUTH_SECRET, SITE_URL, RESEND_API_KEY, AUTH_EMAIL_FROM,
# and optional GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET on the Convex deployment.
# Jev: configure TYPESAFE_API_KEY only on the Convex server deployment.
# A key does not enable analysis: full EU processing evidence, approved versioned
# pricing/analyzer grants and reviewed executable profile references are required.
# Global/account Jev controls default OFF; no VITE_TYPESAFE_* variables.
