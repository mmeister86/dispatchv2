@@ -0,0 +1,32 @@
+import { ConvexError, v } from "convex/values";
+import { mutation, query } from "./_generated/server.js";
+export const deleteResiduals = mutation({
+    args: { workflowId: v.id("workflows") },
+    returns: v.object({ isDone: v.boolean() }),
+    handler: async (ctx, a) => {
+        const workflow = await ctx.db.get("workflows", a.workflowId);
+        if (workflow && !workflow.runResult)
+            throw new ConvexError("ERASURE_WORKFLOW_ACTIVE");
+        const events = await ctx.db
+            .query("events")
+            .withIndex("workflowId_state", (q) => q.eq("workflowId", a.workflowId))
+            .take(25);
+        for (const e of events)
+            await ctx.db.delete("events", e._id);
+        const failures = await ctx.db
+            .query("onCompleteFailures")
+            .withIndex("workflowId", (q) => q.eq("workflowId", a.workflowId))
+            .take(25);
+        for (const f of failures)
+            await ctx.db.delete("onCompleteFailures", f._id);
+        return { isDone: events.length < 25 && failures.length < 25 };
+    },
+});
+export const scopeStatus = query({
+    args: { workflowId: v.id("workflows") },
+    returns: v.union(v.literal("missing"), v.literal("active"), v.literal("complete")),
+    handler: async (ctx, a) => {
+        const root = await ctx.db.get("workflows", a.workflowId);
+        return !root ? "missing" : root.runResult ? "complete" : "active";
+    },
+});
