diff --git a/src/component/guard.ts b/src/component/guard.ts
new file mode 100644
index 0000000000000000000000000000000000000000..00350d560ff342b1c6004bb57e29af4641051003
--- /dev/null
+++ b/src/component/guard.ts
@@ -0,0 +1,22 @@
+import { mutationGeneric, queryGeneric, type FunctionHandle } from "convex/server";
+import { v } from "convex/values";
+export const revision = "dispatch-admission-v1";
+const handles = { create: v.string(), update: v.string(), verificationDelete: v.string() };
+export const configure = mutationGeneric({ args: handles, handler: async (ctx, args) => {
+  const old = await ctx.db.query("admissionGuard").unique();
+  if (old) {
+    if (old.revision !== revision || Object.keys(args).some(key => old[key] !== args[key as keyof typeof args])) throw new Error("AUTH_GUARD_ALREADY_BOUND");
+    return;
+  }
+  await ctx.db.insert("admissionGuard", { revision, ...args });
+}});
+export const health = queryGeneric({ args: {}, handler: async ctx => {
+  const rows = await ctx.db.query("admissionGuard").take(2);
+  return { configured: rows.length === 1 && rows[0].revision === revision, revision: rows[0]?.revision ?? null, count: rows.length };
+}});
+export async function check(ctx: any, args: { model: string; operation: "create" | "update" | "verificationDelete"; id: string; fields: string[]; previousOwner?: string; approvalNonce?: string }) {
+  const config = await ctx.db.query("admissionGuard").unique();
+  if (!config) return true;
+  if (config.revision !== revision) throw new Error("AUTH_GUARD_REVISION_MISMATCH");
+  return await ctx.runMutation(config[args.operation] as FunctionHandle<"mutation">, args);
+}
