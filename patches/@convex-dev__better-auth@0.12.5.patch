--- /dev/null
+++ b/dist/component/guard.js
@@ -0,0 +1,28 @@
+import { mutationGeneric, queryGeneric } from "convex/server";
+import { v } from "convex/values";
+const revision = "dispatch-admission-v1";
+const handles = { create: v.string(), update: v.string(), verificationDelete: v.string() };
+const configure = mutationGeneric({ args: handles, handler: async (ctx, args) => {
+  const old = await ctx.db.query("admissionGuard").unique();
+  if (old) {
+    if (old.revision !== revision || Object.keys(args).some((key) => old[key] !== args[key])) throw new Error("AUTH_GUARD_ALREADY_BOUND");
+    return;
+  }
+  await ctx.db.insert("admissionGuard", { revision, ...args });
+} });
+const health = queryGeneric({ args: {}, handler: async (ctx) => {
+  const rows = await ctx.db.query("admissionGuard").take(2);
+  return { configured: rows.length === 1 && rows[0].revision === revision, revision: rows[0]?.revision ?? null, count: rows.length };
+} });
+async function check(ctx, args) {
+  const config = await ctx.db.query("admissionGuard").unique();
+  if (!config) return true;
+  if (config.revision !== revision) throw new Error("AUTH_GUARD_REVISION_MISMATCH");
+  return await ctx.runMutation(config[args.operation], args);
+}
+export {
+  check,
+  configure,
+  health,
+  revision
+};
