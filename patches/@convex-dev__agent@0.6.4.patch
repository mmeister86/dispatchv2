+import { paginationOptsValidator } from "convex/server";
+import { ConvexError } from "convex/values";
+import { mutation, query, } from "./_generated/server.js";
+import { v } from "./schema.js";
+import { VectorTableNames, getVectorIdInfo } from "./vector/tables.js";
+const owner = v.union(v.string(), v.null());
+const scope = { threadId: v.id("threads"), expectedUserId: owner };
+async function checkThread(ctx, a) {
+    const thread = await ctx.db.get("threads", a.threadId);
+    if (thread && (thread.userId ?? null) !== a.expectedUserId)
+        throw new ConvexError("ERASURE_OWNER_CHANGED");
+    return thread;
+}
+export async function captureFiles(ctx, message) {
+    const thread = await ctx.db.get("threads", message.threadId);
+    for (const fileId of new Set(message.fileIds ?? [])) {
+        const file = await ctx.db.get("files", fileId);
+        if (!file)
+            throw new ConvexError("ERASURE_FILE_MISSING");
+        const old = await ctx.db
+            .query("fileCleanupClaims")
+            .withIndex("threadId_fileId", (q) => q.eq("threadId", message.threadId).eq("fileId", fileId))
+            .unique();
+        if (!old)
+            await ctx.db.insert("fileCleanupClaims", {
+                threadId: message.threadId,
+                userId: thread?.userId ?? message.userId,
+                fileId,
+                storageId: file.storageId,
+                hash: file.hash,
+            });
+    }
+}
+const claim = v.object({
+    fileId: v.id("files"),
+    storageId: v.string(),
+    refcount: v.number(),
+    hash: v.string(),
+});
+export const listForThread = query({
+    args: { ...scope, paginationOpts: paginationOptsValidator },
+    returns: v.object({
+        page: v.array(claim),
+        isDone: v.boolean(),
+        continueCursor: v.string(),
+    }),
+    handler: async (ctx, a) => {
+        const thread = await checkThread(ctx, a);
+        const options = {
+            ...a.paginationOpts,
+            numItems: Math.min(25, a.paginationOpts.numItems),
+        };
+        const files = new Map();
+        let result;
+        if (thread) {
+            const rows = await ctx.db
+                .query("messages")
+                .withIndex("threadId_status_tool_order_stepOrder", (q) => q.eq("threadId", a.threadId))
+                .paginate(options);
+            result = rows;
+            for (const m of rows.page)
+                for (const id of m.fileIds ?? []) {
+                    const f = await ctx.db.get("files", id);
+                    if (!f)
+                        throw new ConvexError("ERASURE_FILE_MISSING");
+                    files.set(f._id, {
+                        fileId: f._id,
+                        storageId: f.storageId,
+                        refcount: f.refcount,
+                        hash: f.hash,
+                    });
+                }
+        }
+        else {
+            const rows = await ctx.db
+                .query("fileCleanupClaims")
+                .withIndex("threadId_fileId", (q) => q.eq("threadId", a.threadId))
+                .paginate(options);
+            result = rows;
+            for (const c of rows.page) {
+                if ((c.userId ?? null) !== a.expectedUserId)
+                    throw new ConvexError("ERASURE_OWNER_CHANGED");
+                const f = await ctx.db.get("files", c.fileId);
+                if (f && f.storageId !== c.storageId)
+                    throw new ConvexError("ERASURE_FILE_CHANGED");
+                files.set(c.fileId, {
+                    fileId: c.fileId,
+                    storageId: c.storageId,
+                    refcount: f?.refcount ?? 0,
+                    hash: c.hash,
+                });
+            }
+        }
+        if (files.size > 100)
+            throw new ConvexError("ERASURE_FILE_PAGE_LIMIT");
+        return {
+            page: [...files.values()],
+            isDone: result.isDone,
+            continueCursor: result.continueCursor,
+        };
+    },
+});
+export const deleteUnusedClaimed = mutation({
+    args: {
+        ...scope,
+        claims: v.array(v.object({ fileId: v.id("files"), storageId: v.string() })),
+    },
+    returns: v.object({
+        deletedStorageIds: v.array(v.string()),
+        sharedFileIds: v.array(v.id("files")),
+    }),
+    handler: async (ctx, a) => {
+        await checkThread(ctx, a);
+        if (a.claims.length > 25)
+            throw new ConvexError("ERASURE_FILE_PAGE_LIMIT");
+        const deletedStorageIds = [], sharedFileIds = [];
+        for (const c of a.claims) {
+            const proof = await ctx.db
+                .query("fileCleanupClaims")
+                .withIndex("threadId_fileId", (q) => q.eq("threadId", a.threadId).eq("fileId", c.fileId))
+                .unique();
+            if (!proof ||
+                proof.storageId !== c.storageId ||
+                (proof.userId ?? null) !== a.expectedUserId)
+                throw new ConvexError("ERASURE_FILE_UNCLAIMED");
+            const f = await ctx.db.get("files", c.fileId);
+            if (f && (f.storageId !== c.storageId || f.refcount < 0))
+                throw new ConvexError("ERASURE_FILE_CHANGED");
+            const aliases = await ctx.db.query("files").withIndex("storageId", q => q.eq("storageId", c.storageId)).take(26);
+            if (aliases.length > 25)
+                throw new ConvexError("ERASURE_FILE_ALIAS_LIMIT");
+            if (aliases.some(alias => alias.refcount < 0))
+                throw new ConvexError("ERASURE_FILE_CHANGED");
+            if (aliases.some(alias => alias.refcount > 0)) {
+                sharedFileIds.push(c.fileId);
+                if (f && f.refcount === 0)
+                    await ctx.db.delete("files", f._id);
+            }
+            else {
+                if (f)
+                    await ctx.db.delete("files", f._id);
+                deletedStorageIds.push(c.storageId);
+            }
+            await ctx.db.delete("fileCleanupClaims", proof._id);
+        }
+        return {
+            deletedStorageIds: [...new Set(deletedStorageIds)],
+            sharedFileIds,
+        };
+    },
+});
+const result = v.object({ isDone: v.boolean(), nextPhase: v.number() });
+async function residuals(ctx, a) {
+    if (!Number.isSafeInteger(a.phase) || a.phase < 0 || a.phase > 10)
+        throw new ConvexError("ERASURE_PHASE_INVALID");
+    const index = a.threadId ? "threadId" : "userId", key = a.threadId ?? a.userId;
+    if (a.phase === 0) {
+        const rows = await ctx.db
+            .query("memories")
+            .withIndex(index, (q) => a.olderThan === undefined ? q.eq(index, key) : q.eq(index, key).lt("_creationTime", a.olderThan))
+            .take(25);
+        for (const m of rows) {
+            if (m.embeddingId) {
+                const { tableName } = getVectorIdInfo(ctx, m.embeddingId);
+                const vector = await ctx.db.get(tableName, m.embeddingId);
+                if (vector && vector[index] === key)
+                    await ctx.db.delete(tableName, m.embeddingId);
+            }
+            await ctx.db.delete("memories", m._id);
+        }
+        return { isDone: false, nextPhase: rows.length === 25 ? 0 : 1 };
+    }
+    const table = VectorTableNames[a.phase - 1];
+    const rows = await ctx.db
+        .query(table)
+        .withIndex(index, (q) => a.olderThan === undefined ? q.eq(index, key) : q.eq(index, key).lt("_creationTime", a.olderThan))
+        .take(25);
+    for (const r of rows)
+        await ctx.db.delete(table, r._id);
+    return {
+        isDone: a.phase === 10 && rows.length < 25,
+        nextPhase: rows.length === 25 ? a.phase : Math.min(10, a.phase + 1),
+    };
+}
+export const deleteThreadResiduals = mutation({
+    args: { ...scope, phase: v.number() },
+    returns: result,
+    handler: async (ctx, a) => {
+        await checkThread(ctx, a);
+        return residuals(ctx, { threadId: a.threadId, phase: a.phase });
+    },
+});
+export const deleteUserMemories = mutation({
+    args: { userId: v.string(), phase: v.number(), olderThan: v.optional(v.number()) },
+    returns: result,
+    handler: async (ctx, a) => residuals(ctx, a),
+});
