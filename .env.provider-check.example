# TASK-1: Copy values into .env.provider-check.local (ignored by Git).
# Never commit credentials. Keep private-key files outside the repository.
# Total user-authorized test budget: EUR 10 across ALL providers.
# No auto top-up. Do not execute this file as a shell script.

# Requesty: a dedicated API key with a low spend cap, if available.
REQUESTY_API_KEY=
# User-selected synthetic test route; no automatic region fallback.
REQUESTY_TEST_MODEL=vertex/gemini-3.5-flash-lite@eu
REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1

# X: existing Developer App, no regeneration of production credentials.
# OAuth 1.0a Consumer/API credentials are DIFFERENT from OAuth2 credentials.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# Obtain these from the OAuth2 User Authentication Settings, not the Consumer section.
X_CLIENT_ID=
# Only for a confidential OAuth client; public clients have no client secret.
X_CLIENT_SECRET=
# App-only bearer token for supported read-only checks, if already available.
X_APP_BEARER_TOKEN=
# Leave empty for now: V1 login was handled by Clerk; no manual token delivery expected.
# A new authorized V2 login flow must establish the user context for later tests.
X_USER_ACCESS_TOKEN=
X_USER_REFRESH_TOKEN=
# Public identifier of the account authorized for test publishing.
X_TEST_ACCOUNT_HANDLE=

# GitHub App from V1. GitHub CLI user login is not an App installation token.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Absolute path to the existing PEM file outside this repository.
GITHUB_APP_PRIVATE_KEY_PATH=
# Explicitly selected test repository, owner/name.
GITHUB_TEST_REPOSITORY=

# Convex: existing development deployment, not production.
CONVEX_URL=
CONVEX_SITE_URL=
# Prefer existing Convex CLI login. No deploy key needed for the initial inventory.

# Cloudflare/R2: leave blank until the existing CLI account is checked.
CLOUDFLARE_ACCOUNT_ID=
R2_TEST_BUCKET=
# A separate limited R2 S3 credential may be required later for the Convex adapter.
# Do not collect or create broad administrator tokens for this initial check.
