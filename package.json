{
  "name": "dispatch-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:evals": "vitest run --config vitest.evals.config.ts",
    "test:browser": "for f in tests/*.browser.mjs; do node \"$f\" || exit 1; done",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:bundle": "node tests/bundle-security.mjs",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"convex/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"shared/*.ts\" \"*.config.ts\" tsconfig.json convex/tsconfig.json \".github/workflows/*.yml\"",
    "test:media-lifecycle": "node tests/media-lifecycle.browser.mjs",
    "test:media-upload": "node tests/media-upload.browser.mjs",
    "test:x-oauth": "node tests/x-oauth.browser.mjs",
    "test:x-thread": "node tests/x-thread.browser.mjs",
    "test:github-app": "node tests/github-app.browser.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.81",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@convex-dev/agent": "0.6.4",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/workflow": "0.4.8",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ai": "6.0.300",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "1.46.0",
    "convex-helpers": "0.1.124",
    "jpeg-js": "0.4.4",
    "lucide-react": "^1.51.0",
    "mp4box": "2.3.0",
    "omggif": "1.0.10",
    "pngjs": "7.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "twitter-text": "3.1.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/omggif": "1.0.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.60",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
