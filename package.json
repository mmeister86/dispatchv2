{
  "name": "dispatch-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:bundle": "node tests/bundle-security.mjs",
    "lint": "prettier --check \"convex/**/*.ts\" convex/tsconfig.json src/lib/auth-client.ts src/lib/navigation.ts src/lib/store.tsx src/main.tsx src/App.tsx src/pages/Public.tsx src/pages/Settings.tsx src/pages/Overview.tsx src/pages/Drafts.tsx src/pages/Calendar.tsx src/components/ScheduleDialog.tsx src/lib/model.ts src/lib/editorial-mapping.ts tests/editorial.test.ts tests/editorial-mapping.test.ts tests/foundation.test.ts tests/navigation.test.ts tests/auth.real-browser.ts tests/bundle-security.mjs playwright.config.ts playwright.auth.config.ts .github/workflows/ci.yml"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "convex": "1.46.0",
    "convex-helpers": "0.1.124",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.60",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
